# Coin Futures Paper Agent configuration
TOP_N_COINS=50
SCORE_THRESHOLD=75
SCAN_INTERVAL_MIN=15
MONITOR_INTERVAL_SEC=60

# Normal mode
PAPER_START_BALANCE=10000
RISK_PER_TRADE_PCT=0.50
MAX_OPEN_TRADES=5
MAX_NEW_TRADES_PER_SCAN=3
MAX_DAILY_LOSS_PCT=3.0

# Temporary high-sample data collection mode.
# true = open every setup that passes strategy filters, one open trade per symbol.
DATA_COLLECTION_MODE=true
COLLECTION_MAX_OPEN_TRADES=50
COLLECTION_RISK_PER_TRADE_PCT=0.10

# V4.2 Strategy Battle Pro: 4 independent paper accounts
STRATEGY_BATTLE_ENABLED=true
BATTLE_START_BALANCE=10000

REWARD_RISK=2.0
STOP_ATR_MULT=1.35
TAKER_FEE_BPS=5
SLIPPAGE_BPS=2

NEWS_REFRESH_MIN=5
NEWS_LOOKBACK_HOURS=48

# News Guardian / Event Risk Engine
NEWS_GUARDIAN_ENABLED=true
NEWS_GUARDIAN_CLUSTER_HOURS=6
NEWS_GUARDIAN_FRESH_MINUTES=45
NEWS_CAUTION_IMPACT=70
NEWS_HIGH_IMPACT=85
NEWS_MARKET_LOCK_IMPACT=90
NEWS_DIRECTION_CONFIDENCE=70
NEWS_GUARDIAN_REVIEW_INTERVAL_MIN=5
NEWS_COOLDOWN_MEDIUM_MIN=10
NEWS_COOLDOWN_HIGH_MIN=20
NEWS_COOLDOWN_EXTREME_MIN=30

TIMEZONE=Asia/Ho_Chi_Minh

# Optional Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Reliability / recovery
NETWORK_RETRIES=4
NETWORK_RETRY_BACKOFF_SEC=1.0
HEALTH_CHECK_INTERVAL_SEC=60
RECOVERY_MAX_HOURS=168
BACKUP_INTERVAL_HOURS=6
BACKUP_RETENTION=20
BACKUP_DIR=backups

# Spot Research Agent (research only, no real orders)
SPOT_RESEARCH_ENABLED=true
SPOT_RESEARCH_INTERVAL_MIN=60
SPOT_TOP_N_COINS=30
SPOT_MIN_QUOTE_VOLUME_USDT=20000000
SPOT_RESEARCH_RESULTS=12
