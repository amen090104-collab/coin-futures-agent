# Temporary high-sample data collection mode.
# true = open every setup that passes strategy filters, one open trade per symbol.
DATA_COLLECTION_MODE=true
COLLECTION_MAX_OPEN_TRADES=50
COLLECTION_RISK_PER_TRADE_PCT=0.10

REWARD_RISK=2.0
STOP_ATR_MULT=1.35
TAKER_FEE_BPS=5
SLIPPAGE_BPS=2

NEWS_REFRESH_MIN=10
NEWS_LOOKBACK_HOURS=48
TIMEZONE=Asia/Ho_Chi_Minh

# Optional Telegram alerts
TELEGRAM_BOT_TOKEN=
